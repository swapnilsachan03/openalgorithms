{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "sourceMap": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@prisma_generated/*": ["./prisma/generated/*"],
      "@controllers/*": ["./src/controllers/*"],
      "@lib/*": ["./src/lib/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@routes/*": ["./src/routes/*"],
      "@graphql/*": ["./src/graphql/*"],
      "@utils/*": ["./src/utils/*"],
      "@generated/*": ["./src/generated/*"]
    },
    "rootDir": "."
  },
  "include": ["./**/*"]
}
